---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Show Interactivo · Experiencias memorables" description="Experiencias interactivas para eventos sociales y corporativos.">
  <section><div class="shell reveal"><img src="/media/images/logo.png" width="180" height="63" alt="Show Interactivo" /><div class="eyebrow">Experiencias memorables</div><h1 class="display-title">¿Qué evento estás <span class="accent">imaginando?</span></h1><p>Elegí el tipo de experiencia para conocer propuestas, testimonios y formas de trabajo.</p><div class="choices"><a href="/sociales" class="glass-card"><strong>Eventos sociales</strong><span>Bodas, cumpleaños de 15 y adultos →</span></a><a href="/corporativos" class="glass-card"><strong>Eventos corporativos</strong><span>Fiestas, team building y otros encuentros →</span></a></div></div></section>
</BaseLayout>
<style>
  section{min-height:100svh;padding:4rem 0;display:grid;place-items:center;background:radial-gradient(circle at 75% 20%,rgba(231,4,143,.2),transparent 35%),linear-gradient(145deg,var(--color-plum),var(--color-plum-dark))}img{width:150px;height:auto;margin-bottom:2rem}.eyebrow{margin-bottom:.6rem}h1{max-width:950px;margin:0;font-size:clamp(3rem,8vw,7rem)}p{max-width:650px;color:var(--light);font-size:1.1rem}.choices{margin-top:2rem;display:grid;grid-template-columns:1fr 1fr;gap:1rem}.choices a{padding:1.5rem;color:white;text-decoration:none;transition:transform .25s ease,border-color .25s ease}.choices a:hover{transform:translateY(-4px);border-color:var(--color-brand)}strong,span{display:block}strong{font-family:var(--font-display);font-size:1.3rem;text-transform:uppercase}span{margin-top:.35rem;color:var(--light)}@media(max-width:650px){.choices{grid-template-columns:1fr}}
</style>
