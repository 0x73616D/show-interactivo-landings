---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Show Interactivo" description="Eventos sociales y corporativos.">
  <section><div class="shell"><img src="/media/images/logo.png" width="180" height="63" alt="Show Interactivo" /><h1 class="display-title">Show Interactivo</h1><div class="choices"><a href="/sociales" class="glass-card"><strong>Eventos sociales</strong></a><a href="/corporativos" class="glass-card"><strong>Eventos corporativos</strong></a></div></div></section>
</BaseLayout>
<style>
  section{min-height:100svh;padding:3rem 0;display:grid;place-items:center;text-align:center;background:radial-gradient(circle at 75% 20%,rgba(231,4,143,.2),transparent 35%),linear-gradient(145deg,var(--color-plum),var(--color-plum-dark))}img{width:150px;height:auto;margin:0 auto 2rem}h1{max-width:950px;margin:0;font-size:clamp(2.75rem,8vw,6rem)}.choices{margin-top:2rem;display:grid;grid-template-columns:1fr 1fr;gap:1rem}.choices a{padding:1.5rem;color:white;text-decoration:none;transition:transform .25s ease,border-color .25s ease}.choices a:hover{transform:translateY(-4px);border-color:var(--color-brand)}strong{display:block;font-family:var(--font-display);font-size:1.3rem;text-transform:uppercase}@media(max-width:650px){section{padding:2rem 0}.choices{grid-template-columns:1fr}.choices a{padding:1.2rem}h1{font-size:clamp(2.4rem,14vw,4rem)}}
</style>
