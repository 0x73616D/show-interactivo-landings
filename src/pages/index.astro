<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content="Elegí entre eventos sociales y corporativos de Show Interactivo." />
    <title>Show Interactivo · Elegí tu experiencia</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Montserrat:wght@700;800;900&display=swap" rel="stylesheet" />
  </head>
  <body>
    <main>
      <header>
        <img src="/media/images/logo.png" width="190" height="67" alt="Show Interactivo" />
        <p class="eyebrow">Experiencias memorables</p>
        <h1>Elegí el tipo de <em>evento.</em></h1>
      </header>

      <nav aria-label="Elegir tipo de evento">
        <a class="choice choice-social" href="/sociales">
          <span class="choice-copy">
            <small>Celebraciones</small>
            <strong>Sociales</strong>
            <span>Bodas, cumpleaños de 15 y adultos <b aria-hidden="true">→</b></span>
          </span>
        </a>
        <a class="choice choice-corporate" href="/corporativos">
          <span class="choice-copy">
            <small>Empresas y equipos</small>
            <strong>Corporativos</strong>
            <span>Fiestas, team building y otros encuentros <b aria-hidden="true">→</b></span>
          </span>
        </a>
      </nav>

      <footer>Show Interactivo © 2026</footer>
    </main>
  </body>
</html>

<style>
  :root{--bg:#4c1c56;--deep:#2a0e30;--accent:#e7048f;--white:#fff;--line:rgba(255,255,255,.18)}
  *{box-sizing:border-box;margin:0;padding:0}
  html,body{width:100%;height:100%;overflow:hidden}
  body{background:radial-gradient(circle at 75% 12%,rgba(231,4,143,.22),transparent 32%),linear-gradient(145deg,var(--bg),var(--deep));color:var(--white);font-family:'Inter',system-ui,sans-serif;-webkit-font-smoothing:antialiased}
  main{width:min(1040px,100%);height:100svh;min-height:520px;margin:0 auto;padding:max(18px,env(safe-area-inset-top)) clamp(18px,4vw,44px) max(14px,env(safe-area-inset-bottom));display:grid;grid-template-rows:auto minmax(0,1fr) auto;gap:clamp(12px,2.2vh,24px)}
  header{text-align:center}
  header img{display:block;width:clamp(118px,18vh,172px);height:auto;margin:0 auto clamp(8px,1.4vh,14px)}
  .eyebrow{color:rgba(255,255,255,.78);font-size:clamp(10px,1.5vh,13px);font-weight:700;letter-spacing:.16em;text-transform:uppercase}
  h1{font-family:'Montserrat',system-ui,sans-serif;font-size:clamp(27px,5.6vh,58px);font-weight:900;line-height:1;letter-spacing:-.03em;text-transform:uppercase;margin-top:clamp(5px,1vh,10px)}
  h1 em{color:var(--accent);font-style:normal}
  nav{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:clamp(12px,2vw,20px);min-height:0}
  .choice{position:relative;isolation:isolate;display:flex;align-items:flex-end;min-height:0;border:1px solid var(--line);border-radius:22px;overflow:hidden;color:var(--white);text-decoration:none;background-position:center;background-size:cover;box-shadow:0 16px 44px rgba(0,0,0,.28);transition:transform .25s ease,border-color .25s ease}
  .choice::before{content:"";position:absolute;inset:0;z-index:-1;background:linear-gradient(180deg,rgba(25,6,30,.05) 10%,rgba(25,6,30,.9) 88%)}
  .choice:hover,.choice:focus-visible{transform:translateY(-3px);border-color:var(--accent);outline:none}
  .choice-social{background-image:url('/media/images/events/SI-Boda-Resultado-02.jpg')}
  .choice-corporate{background-image:url('/media/images/events/SI-Fiesta-Evento-01.jpg')}
  .choice-copy{display:block;width:100%;padding:clamp(15px,3vh,28px)}
  .choice-copy small,.choice-copy strong,.choice-copy > span{display:block}
  .choice-copy small{font-size:clamp(10px,1.5vh,13px);font-weight:700;letter-spacing:.13em;text-transform:uppercase;color:#f7a7d7}
  .choice-copy strong{font-family:'Montserrat',system-ui,sans-serif;font-size:clamp(22px,4.2vh,40px);font-weight:900;line-height:1.05;text-transform:uppercase;margin:4px 0}
  .choice-copy > span{font-size:clamp(11px,1.7vh,14px);color:rgba(255,255,255,.86)}
  .choice-copy b{color:var(--accent);font-size:1.25em;margin-left:4px}
  footer{text-align:center;color:rgba(255,255,255,.55);font-size:11px}
  @media(max-width:620px){
    main{gap:10px;padding-left:16px;padding-right:16px}
    nav{grid-template-columns:1fr;gap:10px}
    .choice{border-radius:18px}
    .choice-copy{padding:14px 18px}
  }
  @media(max-height:620px) and (orientation:landscape){
    main{grid-template-columns:190px 1fr;grid-template-rows:1fr auto;align-items:center;gap:12px 20px}
    header{text-align:left}
    header img{margin-left:0}
    nav{grid-template-columns:repeat(2,minmax(0,1fr));height:100%;max-height:420px}
    footer{grid-column:1/-1}
  }
  @media(prefers-reduced-motion:reduce){.choice{transition:none}}
</style>
