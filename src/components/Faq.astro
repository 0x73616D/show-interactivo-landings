---
interface Item { question: string; answer: string }
interface Props { items: Item[] }
const { items } = Astro.props;
---
<section class="faq section" id="faq">
  <div class="shell">
    <div class="section-heading reveal"><div class="eyebrow">Todo claro</div><h2>Preguntas frecuentes</h2></div>
    <div class="list reveal">
      {items.map((item,index) => (
        <details>
          <summary><span>{String(index+1).padStart(2,'0')}</span>{item.question}</summary>
          <p>{item.answer}</p>
        </details>
      ))}
    </div>
  </div>
</section>
<style>
  .faq{background:var(--color-plum-deep)} .list{border-top:1px solid var(--line)}
  details{border-bottom:1px solid var(--line)}
  summary{display:flex;gap:1rem;align-items:flex-start;padding:1.2rem 0;cursor:pointer;font-weight:700;list-style:none}
  summary::-webkit-details-marker{display:none} summary::after{content:'+';margin-left:auto;color:var(--color-brand);font-size:1.4rem;line-height:1} details[open] summary::after{content:'−'}
  summary span{color:var(--color-brand);font-size:.75rem;letter-spacing:.1em}
  p{max-width:900px;margin:-.35rem 0 1.4rem 2.5rem;color:var(--light)}
</style>
