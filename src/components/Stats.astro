---
interface Stat { value: number; prefix?: string; decimals?: number; label: string }
interface Props { stats: Stat[] }
const { stats } = Astro.props;
---
<section class="stats section-tight reveal" aria-label="Cifras destacadas">
  <div class="shell grid">
    {stats.map(stat => (
      <div>
        <div class="number" data-counter data-target={stat.value} data-prefix={stat.prefix ?? ''} data-decimals={stat.decimals ?? 0}>{stat.prefix}{stat.value}</div>
        <div class="label">{stat.label}</div>
      </div>
    ))}
  </div>
</section>
<style>
  .stats { border-block: 1px solid var(--line); background: var(--color-plum-deep); }
  .grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 2rem; text-align: center; }
  .number { color: var(--color-brand); font-family: var(--font-display); font-size: clamp(3rem,7vw,6rem); font-weight: 900; letter-spacing: -.04em; line-height: 1; }
  .label { margin-top: .65rem; color: var(--light); font-size: .74rem; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; }
  @media(max-width:640px){
    .grid{grid-template-columns:repeat(3,minmax(0,1fr));gap:.55rem}
    .number{font-size:clamp(2rem,10vw,3rem)}
    .label{margin-top:.45rem;font-size:.58rem;line-height:1.35;letter-spacing:.08em}
  }
</style>
