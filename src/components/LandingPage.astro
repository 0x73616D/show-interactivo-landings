---
import siteData from '../data/site.json';
import pages from '../data/pages.json';
import LandingHero from './LandingHero.astro';
import Stats from './Stats.astro';
import LandingExperience from './LandingExperience.astro';
import Differences from './Differences.astro';
import FeaturedTestimonials from './FeaturedTestimonials.astro';
import LogoWall from './LogoWall.astro';
import Faq from './Faq.astro';
import Contact from './Contact.astro';

interface Props { variant: 'sociales' | 'corporativos' }
const { variant } = Astro.props;
const page = (pages as any)[variant];
const content = (siteData.landing as any)[variant];
const videos = (siteData.heroVideos as any)[variant];
const firstType = page.tabs[0]?.id as string;
const initial = content[firstType];
const featured = (siteData.featuredTestimonials as any)[variant];
const initialTestimonials = variant === 'sociales' ? featured[firstType] : featured;
const target = variant === 'sociales' ? '/sociales/testimonios' : '/corporativos/testimonios';
const initialHeading = variant === 'sociales' ? initial.testiTitleHtml : 'Lo que dicen de nosotros.';
---

<LandingHero hero={page.hero} tabs={page.tabs} initialVideo={videos[firstType]} variant={variant} />
<LandingExperience initial={initial} variant={variant} />
<Stats stats={page.stats} />
<Differences items={page.differences} />
<FeaturedTestimonials items={initialTestimonials} target={target} heading={initialHeading} />
<LogoWall logos={pages.logos} />
<Faq items={page.faqs} />
<Contact variant={variant} />

<script is:inline define:vars={{ content, videos, featured, variant, firstType }}>
  const tabs = document.querySelectorAll('[data-event-tab]');
  const heroVideo = document.getElementById('hero-video');
  const escapeHtml = (value = '') => String(value).replace(/[&<>'"]/g, char => ({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[char]));

  function updateJourney(key, data) {
    const card = document.querySelector(`[data-journey="${key}"]`);
    if (!card) return;
    const description = key === 'previa' ? data.previaDesc : key === 'evento' ? (data.eventoDesc || 'Somos el hilo conductor del encuentro y cuidamos cada transición para sostener la energía.') : data.resultadoDesc;
    const points = key === 'previa' ? data.previaPoints : key === 'evento' ? data.eventoPoints : (data.resultadoPoints || []);
    const imagePrefix = key[0].toUpperCase() + key.slice(1);
    card.querySelector('[data-description]').textContent = description;
    card.querySelector('ul').innerHTML = points.map(point => `<li>${escapeHtml(point)}</li>`).join('');
    card.querySelector('[data-image="top"]').src = data[`visual${imagePrefix}Top`];
    card.querySelector('[data-image="bottom"]').src = data[`visual${imagePrefix}Bot`];
  }

  function renderFeatured(type, data) {
    const grid = document.getElementById('featured-testimonials');
    const items = variant === 'sociales' ? featured[type] : featured;
    if (!grid) return;
    grid.innerHTML = items.map(item => `<article class="glass-card reveal"><p>“${escapeHtml(item.quote)}”</p><strong>${escapeHtml(item.author)}</strong><span>${escapeHtml(item.event)}</span></article>`).join('');
    const heading = document.getElementById('testimonial-heading');
    if (heading && data.testiTitleHtml) heading.innerHTML = data.testiTitleHtml;
    window.showInteractivo?.observeReveals(grid);
  }

  function setEvent(type) {
    const data = content[type];
    if (!data) return;
    tabs.forEach(tab => {
      const active = tab.dataset.eventTab === type;
      tab.classList.toggle('active', active);
      tab.setAttribute('aria-selected', String(active));
    });
    if (heroVideo && heroVideo.getAttribute('src') !== videos[type]) {
      heroVideo.classList.add('is-swapping');
      setTimeout(() => { heroVideo.src = videos[type]; heroVideo.load(); heroVideo.play().catch(() => {}); heroVideo.classList.remove('is-swapping'); }, 220);
    }
    const title = document.getElementById('sub-title');
    const description = document.getElementById('sub-description');
    const eyebrow = document.getElementById('sub-eyebrow');
    const tagline = document.getElementById('sub-tagline');
    if (title) title.innerHTML = data.subTitleHtml || escapeHtml(data.subTitle);
    if (description) description.innerHTML = data.subDescHtml || escapeHtml(data.subDesc);
    if (eyebrow && data.subEyebrow) eyebrow.textContent = data.subEyebrow;
    if (tagline && data.subTagline) tagline.textContent = data.subTagline;
    ['previa','evento','resultado'].forEach(key => updateJourney(key, data));
    renderFeatured(type, data);
    try { localStorage.setItem(`si_${variant}_tab`, type); } catch {}
  }

  tabs.forEach(tab => tab.addEventListener('click', () => setEvent(tab.dataset.eventTab)));
  let initialType = firstType;
  try {
    const saved = localStorage.getItem(`si_${variant}_tab`);
    if (saved && content[saved]) initialType = saved;
  } catch {}
  if (initialType !== firstType) setEvent(initialType);
</script>
