---
interface Logo { src: string; alt: string }
interface Props { logos: Logo[] }
const { logos } = Astro.props;
---
<section class="logos section-tight" aria-labelledby="logos-title">
  <div class="shell"><h2 id="logos-title">Cientos de familias y empresas confían en nosotros</h2></div>
  <div class="track" aria-hidden="true">
    {[...logos,...logos].map(logo => <div class="logo-card"><img src={logo.src} alt="" width="140" height="100" loading="lazy" decoding="async" /></div>)}
  </div>
</section>
<style>
  .logos{overflow:hidden;border-block:1px solid var(--line);background:var(--color-plum-deep)}
  h2{margin:0 0 1.5rem;font-family:var(--font-display);font-size:clamp(1.3rem,3vw,2rem);text-align:center;text-transform:uppercase}
  .track{width:max-content;display:flex;gap:.75rem;animation:marquee 55s linear infinite}
  .track:hover{animation-play-state:paused}
  .logo-card{width:120px;height:90px;padding:.8rem;display:grid;place-items:center;flex:none;border-radius:.8rem;background:white}
  img{width:100%;height:100%;object-fit:contain}
  @keyframes marquee{to{transform:translateX(-50%)}}
</style>
