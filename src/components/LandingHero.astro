---
interface Tab { id: string; name: string; sub: string }
interface Props {
  hero: { eyebrow: string; title: string; description: string };
  tabs: Tab[];
  initialVideo: string;
  variant: 'sociales' | 'corporativos';
}
const { hero, tabs, initialVideo, variant } = Astro.props;
const whatsapp = variant === 'sociales' ? 'https://wa.me/5411300555' : 'https://wa.me/541124629086';
---

<section class="hero">
  <video id="hero-video" src={initialVideo} autoplay muted loop playsinline preload="metadata" aria-hidden="true"></video>
  <div class="shade"></div>
  <div class="shell hero-content">
    <div class="eyebrow is-visible">{hero.eyebrow}</div>
    <h1 class="display-title is-visible">{hero.title}</h1>
    {hero.description && <p class="is-visible">{hero.description}</p>}
    <div class="actions is-visible">
      <a href="#contacto" class="button button-primary">Cotizar mi evento</a>
      <a href={whatsapp} class="button button-secondary" target="_blank" rel="noopener">Hablar por WhatsApp</a>
    </div>
    <div class="tabs" role="tablist" aria-label="Tipo de evento">
      {tabs.map((tab, index) => (
        <button class:list={['event-tab', { active: index === 0 }]} type="button" role="tab" aria-selected={index === 0 ? 'true' : 'false'} data-event-tab={tab.id}>
          <strong>{tab.name}</strong><span>{tab.sub}</span>
        </button>
      ))}
    </div>
  </div>
</section>

<style>
  .hero { position: relative; min-height: min(780px, 100svh); padding: 8rem 0 1.75rem; display: flex; align-items: flex-end; overflow: hidden; background: var(--color-plum-deep); }
  video, .shade { position: absolute; inset: 0; width: 100%; height: 100%; }
  video { object-fit: cover; opacity: .44; transition: opacity .25s ease; }
  video.is-swapping { opacity: 0; }
  .shade { background: linear-gradient(180deg, rgba(42,14,48,.45) 0%, rgba(42,14,48,.42) 35%, rgba(42,14,48,.96) 100%); }
  .hero-content { position: relative; z-index: 1; }
  h1 { max-width: 980px; margin: .65rem 0 .9rem; font-size: clamp(2.7rem, 6.3vw, 5rem); text-wrap: balance; }
  .hero-content > p { max-width: 700px; margin: 0; color: var(--light); font-size: clamp(1rem, 2vw, 1.25rem); }
  .actions { display: flex; flex-wrap: wrap; gap: .8rem; margin-top: 1.5rem; }
  .tabs { margin-top: clamp(1.75rem, 4vw, 3.25rem); display: grid; grid-template-columns: repeat(3, 1fr); gap: .8rem; }
  .event-tab { min-width: 0; padding: 1rem 1.1rem; border: 1px solid rgba(255,255,255,.18); border-radius: 1rem; background: rgba(255,255,255,.08); color: white; text-align: left; cursor: pointer; backdrop-filter: blur(12px); transition: transform .25s ease, background .25s ease, border-color .25s ease; }
  .event-tab:hover { transform: translateY(-2px); background: rgba(255,255,255,.13); }
  .event-tab.active { border-color: var(--color-brand); background: rgba(231,4,143,.2); }
  .event-tab strong, .event-tab span { display: block; }
  .event-tab strong { font-family: var(--font-display); font-size: .95rem; text-transform: uppercase; }
  .event-tab span { margin-top: .15rem; color: var(--light); font-size: .78rem; }
  @media (max-width: 900px) {
    .hero { min-height: auto; padding-top: 7rem; }
  }
  @media (max-width: 700px) {
    .hero { padding: 6.4rem 0 1.15rem; }
    h1 { max-width: 560px; font-size: clamp(2.35rem, 11vw, 3.8rem); }
    .hero-content > p { font-size: .98rem; }
    .actions { display: grid; grid-template-columns: 1fr 1fr; gap: .55rem; margin-top: 1.2rem; }
    .actions .button { width: 100%; min-height: 44px; padding-inline: .8rem; font-size: .72rem; }
    .tabs { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: .4rem; margin-top: 1.45rem; }
    .event-tab { min-height: 68px; padding: .7rem .6rem; text-align: center; }
    .event-tab strong { font-size: .7rem; line-height: 1.18; overflow-wrap: anywhere; }
    .event-tab span { font-size: .66rem; line-height: 1.25; }
  }
  @media (max-width: 480px) {
    .event-tab span { display: none; }
    .event-tab { min-height: 56px; }
  }
  @media (max-width: 380px) {
    .actions { grid-template-columns: 1fr; }
  }
</style>
