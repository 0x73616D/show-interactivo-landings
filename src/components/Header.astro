---
interface Props { variant: 'sociales' | 'corporativos' }
const { variant } = Astro.props;
const isSocial = variant === 'sociales';
const home = isSocial ? '/sociales' : '/corporativos';
const testimonials = `${home}/testimonios`;
const other = isSocial ? '/corporativos' : '/sociales';
---

<header data-site-nav>
  <div class="shell nav-inner">
    <a href={home} aria-label="Show Interactivo — inicio"><img src="/media/images/logo.png" width="180" height="63" alt="Show Interactivo" /></a>
    <nav id="main-navigation" aria-label="Navegación principal">
      <a href={home}>Inicio</a>
      <a href={`${home}#experiencia`}>Experiencia</a>
      <a href={testimonials}>Testimonios</a>
      <a href={`${home}#faq`}>FAQ</a>
      <a href={other}>{isSocial ? 'Corporativos' : 'Sociales'}</a>
    </nav>
    <a href={`${home}#contacto`} class="nav-cta">Cotizar evento</a>
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="main-navigation" aria-label="Abrir menú">☰</button>
  </div>
</header>

<script>
  const toggle = document.querySelector('.menu-toggle');
  const menu = document.getElementById('main-navigation');
  toggle?.addEventListener('click', () => {
    const isOpen = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!isOpen));
    toggle.setAttribute('aria-label', isOpen ? 'Abrir menú' : 'Cerrar menú');
    menu?.classList.toggle('is-open', !isOpen);
  });
</script>

<style>
  header { position: fixed; inset: 0 0 auto; z-index: 100; border-bottom: 1px solid transparent; background: rgba(76,28,86,.66); backdrop-filter: blur(16px); transition: background .3s ease, border-color .3s ease, box-shadow .3s ease; }
  header.is-scrolled { border-color: var(--line); background: rgba(42,14,48,.94); box-shadow: 0 8px 30px rgba(0,0,0,.24); }
  .nav-inner { min-height: 72px; display: flex; align-items: center; gap: 2rem; }
  img { width: 148px; height: auto; }
  nav { margin-left: auto; display: flex; align-items: center; gap: 1.5rem; }
  nav a { color: white; font-size: .86rem; font-weight: 650; text-decoration: none; transition: color .2s ease; }
  nav a:hover { color: var(--color-brand); }
  .nav-cta { padding: .65rem 1.1rem; border-radius: 999px; background: white; color: var(--color-plum); font-size: .78rem; font-weight: 800; text-decoration: none; text-transform: uppercase; transition: transform .2s ease, background .2s ease, color .2s ease; }
  .nav-cta:hover { background: var(--color-brand); color: white; transform: translateY(-1px); }
  .menu-toggle { display: none; margin-left: auto; border: 0; background: transparent; color: white; font-size: 1.6rem; cursor: pointer; }
  @media (max-width: 880px) {
    .nav-cta { display: none; }
    .menu-toggle { display: block; }
    nav { position: absolute; inset: 72px 0 auto; display: none; padding: 1.25rem 24px 1.6rem; background: rgba(42,14,48,.98); border-bottom: 1px solid var(--line); flex-direction: column; align-items: flex-start; }
    nav.is-open { display: flex; }
    nav a { width: 100%; padding-block: .45rem; }
  }
</style>
