---
import siteData from '../data/site.json';
interface Props { variant: 'sociales' | 'corporativos' }
const { variant } = Astro.props;
const corporate = variant === 'corporativos';
const whatsapp = corporate ? 'https://wa.me/541124629086' : 'https://wa.me/5411300555';
const phone = corporate ? '+54 11 2462-9086' : '+54 11 3005-555';
---

<footer>
  <div class="shell footer-grid">
    <div><img src="/media/images/logo.png" width="180" height="63" loading="lazy" alt="Show Interactivo" /><p>Experiencias memorables</p></div>
    <div class="contact">
      <a href={whatsapp} target="_blank" rel="noopener">WhatsApp {corporate ? 'Corporativos' : 'Sociales'} · {phone}</a>
      <a href={siteData.links.instagram} target="_blank" rel="noopener">Instagram · {siteData.links.instagramLabel}</a>
    </div>
  </div>
  <div class="shell copyright">Show Interactivo © 2026 · Todos los derechos reservados.</div>
</footer>
<a class="wa" href={whatsapp} target="_blank" rel="noopener" aria-label="Contactar por WhatsApp">WA</a>

<style>
  footer { padding: 3rem 0 1.5rem; border-top: 1px solid var(--line); background: var(--color-plum-dark); }
  .footer-grid { display: grid; grid-template-columns: 1fr auto; gap: 2rem; align-items: center; }
  img { width: 148px; height: auto; }
  p { margin: .5rem 0 0; color: var(--muted); font-size: .78rem; letter-spacing: .12em; text-transform: uppercase; }
  .contact { display: grid; gap: .5rem; text-align: right; }
  .contact a { color: var(--light); font-size: .88rem; text-decoration: none; }
  .contact a:hover { color: var(--color-brand); }
  .copyright { margin-top: 1.5rem; padding-top: 1.5rem; border-top: 1px solid var(--line); color: var(--muted); font-size: .75rem; text-align: center; }
  .wa { position: fixed; right: 1.25rem; bottom: 1.25rem; z-index: 90; width: 54px; height: 54px; display: grid; place-items: center; border-radius: 50%; background: #25d366; color: white; box-shadow: 0 10px 26px rgba(37,211,102,.35); font-size: .76rem; font-weight: 900; text-decoration: none; transition: transform .2s ease; }
  .wa:hover { transform: scale(1.07); }
  @media (max-width: 680px) { .footer-grid { grid-template-columns: 1fr; text-align: center; } img { margin-inline: auto; } .contact { text-align: center; } }
</style>
