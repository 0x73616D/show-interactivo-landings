---
interface Props { variant: 'sociales' | 'corporativos'; title: string; description: string }
const { variant, title, description } = Astro.props;
const home = variant === 'sociales' ? '/sociales' : '/corporativos';
---
<section class="hero"><div class="shell"><a href={home}>← Volver a la Home</a><div class="eyebrow">Show Interactivo · {variant === 'sociales' ? 'Sociales' : 'Corporativos'}</div><h1 class="display-title" set:html={title}></h1><p>{description}</p></div></section>
<style>
  .hero{padding:7.75rem 0 3rem;text-align:center;background:linear-gradient(135deg,var(--color-plum),var(--color-plum-deep))}
  a{display:inline-block;margin-bottom:1rem;color:var(--light);text-decoration:none;font-weight:650} a:hover{color:var(--color-brand)}
  h1{max-width:900px;margin:.7rem auto 1rem;font-size:clamp(2.6rem,7vw,5rem)} p{max-width:700px;margin:0 auto;color:var(--light);font-size:1.05rem}
  @media(max-width:640px){.hero{padding:6.5rem 0 2.4rem}h1{font-size:clamp(2.25rem,12vw,3.25rem)}p{font-size:.96rem}}
</style>
