---
import siteData from '../data/site.json';
import pages from '../data/pages.json';
const groups = siteData.socialTestimonials;
const tabs = pages.sociales.tabs;
const initialType = 'adulto';
const initial = groups[initialType];
---
<section class="selector section-tight"><div class="shell"><div class="label">¿Qué tipo de evento te interesa?</div><div class="tabs" role="tablist">{tabs.map(tab => <button type="button" class:list={['tab',{active:tab.id===initialType}]} data-text-tab={tab.id} role="tab" aria-selected={tab.id===initialType?'true':'false'}><strong>{tab.name}</strong><span>{tab.sub}</span></button>)}</div></div></section>
<section class="testimonials section-tight"><div class="shell"><div class="home"><a href="/sociales" class="button button-secondary">← Volver a la Home</a></div><div class="grid" id="text-testimonials">{initial.map(item => <article class="glass-card reveal"><strong>{item.name}</strong>{item.title && <h2>{item.title}</h2>}<p>{item.body}</p></article>)}</div><div class="home bottom"><a href="/sociales" class="button button-secondary">← Volver a la Home</a></div></div></section>
<script is:inline define:vars={{ groups }}>
  const grid = document.getElementById('text-testimonials');
  const tabs = document.querySelectorAll('[data-text-tab]');
  const escapeHtml = value => String(value || '').replace(/[&<>'"]/g, char => ({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[char]));
  function render(type){
    tabs.forEach(tab => { const active=tab.dataset.textTab===type; tab.classList.toggle('active',active); tab.setAttribute('aria-selected',String(active)); });
    grid.innerHTML=groups[type].map(item=>`<article class="glass-card reveal"><strong>${escapeHtml(item.name)}</strong>${item.title?`<h2>${escapeHtml(item.title)}</h2>`:''}<p>${escapeHtml(item.body)}</p></article>`).join('');
    window.showInteractivo?.observeReveals(grid);
    try{localStorage.setItem('si_social_testimonials',type)}catch{}
  }
  tabs.forEach(tab=>tab.addEventListener('click',()=>render(tab.dataset.textTab)));
  try{const saved=localStorage.getItem('si_social_testimonials');if(saved&&groups[saved])render(saved)}catch{}
</script>
<style>
  .selector{background:var(--color-plum-deep);border-block:1px solid var(--line)} .label{text-align:center;color:var(--muted);font-size:.74rem;font-weight:700;letter-spacing:.14em;text-transform:uppercase;margin-bottom:.8rem}
  .tabs{display:grid;grid-template-columns:repeat(3,1fr);gap:.8rem}.tab{padding:1rem;border:2px solid var(--line);border-radius:1rem;background:rgba(255,255,255,.035);color:white;text-align:left;cursor:pointer;transition:.25s}.tab:hover,.tab.active{border-color:var(--color-brand);background:rgba(231,4,143,.12);transform:translateY(-2px)}.tab strong,.tab span{display:block}.tab strong{font-family:var(--font-display);text-transform:uppercase}.tab span{color:var(--muted);font-size:.78rem}
  .grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem}.grid article{padding:1.5rem;transition:transform .25s ease,border-color .25s ease}.grid article:hover{transform:translateY(-4px);border-color:rgba(231,4,143,.4)}article>strong{font-family:var(--font-display);font-size:.84rem;text-transform:uppercase}h2{color:var(--color-brand);font-family:var(--font-display);font-size:1.05rem}p{color:var(--light);font-size:.9rem}.home{text-align:center;margin-bottom:1.5rem}.bottom{margin:1.7rem 0 0}
  @media(max-width:900px){.grid{grid-template-columns:repeat(2,1fr)}}@media(max-width:650px){.tabs,.grid{grid-template-columns:1fr}}
</style>
