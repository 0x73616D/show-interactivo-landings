---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  variant?: 'sociales' | 'corporativos' | 'neutral';
}

const { title, description, variant = 'neutral' } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#4c1c56" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Montserrat:wght@600;700;800;900&display=swap" rel="stylesheet" />
    <link rel="icon" href="/media/images/logo.png" type="image/png" />
    <title>{title}</title>
  </head>
  <body>
    {variant !== 'neutral' && <Header variant={variant} />}
    <main><slot /></main>
    {variant !== 'neutral' && <Footer variant={variant} />}

    <script>
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const revealObserver = !reduceMotion && 'IntersectionObserver' in window
        ? new IntersectionObserver((entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                revealObserver?.unobserve(entry.target);
              }
            }
          }, { threshold: 0.12, rootMargin: '0px 0px -48px' })
        : null;

      function observeReveals(root = document) {
        root.querySelectorAll('.reveal:not(.is-visible)').forEach((element) => {
          const rect = element.getBoundingClientRect();
          if (rect.top < window.innerHeight - 16 && rect.bottom > 0) element.classList.add('is-visible', 'reveal-instant');
          else if (revealObserver) revealObserver.observe(element);
          else element.classList.add('is-visible');
        });
      }

      window.showInteractivo = { observeReveals };
      observeReveals();

      const nav = document.querySelector('[data-site-nav]');
      window.addEventListener('scroll', () => nav?.classList.toggle('is-scrolled', window.scrollY > 40), { passive: true });

      document.querySelectorAll('[data-counter]').forEach((element) => {
        const target = Number(element.getAttribute('data-target') ?? 0);
        const prefix = element.getAttribute('data-prefix') ?? '';
        const decimals = Number(element.getAttribute('data-decimals') ?? 0);
        const render = (value: number) => { element.textContent = prefix + value.toFixed(decimals); };
        const startCounter = () => {
          if (reduceMotion) { render(target); return; }
          const start = performance.now();
          const duration = 1400;
          const tick = (now: number) => {
            const progress = Math.min((now - start) / duration, 1);
            render(target * (1 - Math.pow(1 - progress, 3)));
            if (progress < 1) requestAnimationFrame(tick);
          };
          requestAnimationFrame(tick);
        };
        if ('IntersectionObserver' in window) {
          const counterObserver = new IntersectionObserver(([entry]) => {
            if (entry?.isIntersecting) { startCounter(); counterObserver.disconnect(); }
          }, { threshold: 0.55 });
          counterObserver.observe(element);
        } else startCounter();
      });
    </script>
  </body>
</html>

<style is:global>
  body::selection { background: #e7048f; color: white; }
</style>
